# ==============================================================
# Sky Prime Shore Bank — environment template
# Copy to .env and fill with YOUR values. NEVER commit .env.
# All values below are PLACEHOLDERS — substitute your real values.
# ==============================================================

# --- Server ---
# Port serve.js listens on (default 12000)
PORT=12000

# --- Supabase ---
# PostgREST API URL. For self-hosting: http://127.0.0.1:8000
# For a hosted Supabase project: https://<PROJECT_REF>.supabase.co
SUPABASE_API_URL=http://127.0.0.1:54321

# Anon (public) key — rewrite target at serve time.
SUPABASE_ANON_KEY=<SUPA_ANON_KEY>

# Embedded client config placeholders (in HTML/JS) that serve.js rewrites
# (at deployment these must be replaced with the real Supabase project URL/anon key. 
SUPA_URL=https://<PROJECT_REF>.supabase.co
SUPA_KEY=<SUPA_ANON_KEY>
# Edge Function (register) project — different Supabase project owning the function.

SUPA_EDGE_URL=https://<EDGE_PROJECT_REF>.supabase.co
SUPA_EDGE_ANON_KEY=<SUPA_EDGE_ANON_KEY>

# --- Supabase CLI (self-hosted local stack) ---
SUPA_LOCAL_ANON_KEY=<SUPA_LOCAL_ANON_KEY>

# --- CI/CD (GitHub Actions secrets; never needed at runtime) ---
# Supabase Management API personal access token (Dashboard > Account > tokens)
SUPABASE_ACCESS_TOKEN=
# 20-char Supabase project ref (must equal the <PROJECT_REF> derived from SUPA_URL)
SUPABASE_PROJECT_REF=
# Vercel deploy integration (optional)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- App / domain ---
APP_URL=https://skyprimeshorebank.com
SITE_URL=https://skyprimeshorebank.com
APP_NAME=Sky Prime Shore Bank
SUPPORT_EMAIL=support@skyprimeshorebank.com
ADMIN_EMAIL=admin@skyprimeshorebank.com

# --- Optional placeholders for any future SMTP / payments / storage ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
